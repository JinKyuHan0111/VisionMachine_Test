# docker/ 폴더 안에서 복사해서 사용:  cp .env.example .env  &&  chmod 600 .env
# (로컬 개발용 .env 는 프로젝트 루트, 배포용 .env 는 docker/ 에 둠)
# .env 는 절대 git 에 커밋하지 말 것 (.gitignore / .dockerignore 에 포함됨)

# ─── 서버 도메인 ─────────────────────────────────────
# Caddy 가 이 도메인으로 Let's Encrypt 인증서를 자동 발급 (DNS A 레코드가 서버 IP 를 가리켜야 함)
# 도메인이 없으면 연습용으로 <서버IP>.sslip.io 사용 가능 (예: 203.0.113.10.sslip.io)
DOMAIN=fire.example.com
APP_BASE_URL=https://fire.example.com

# ─── 세션 서명 키 (필수, 32자 이상) ──────────────────
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# ─── 초기 관리자 계정 (필수) ─────────────────────────
# 최초 기동 시 1회만 생성됨. 이후 이 값을 바꿔도 기존 비밀번호는 바뀌지 않음.
# 12자 이상, 기본값(changeme 등) 사용 시 서버가 기동을 거부함
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ─── 이메일 (Gmail 앱 비밀번호) ──────────────────────
# 계정 비밀번호가 아닌 2단계 인증 후 발급하는 '앱 비밀번호' 사용
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# ─── 이미지 버전 ─────────────────────────────────────
# GHCR 에서 받을 태그: latest(main 최신) 또는 sha-xxxxxxx(특정 커밋)
IMAGE_TAG=latest

# ─── 감지기 (현장 PC 에서만) ──────────────────────────
# detector 를 켜면 app 과 함께 감지기 컨테이너도 실행됨. 대시보드만 띄울 서버에서는 비워 둘 것
# 모델 파일은 프로젝트 루트의 models/fire_detector_best.pt 에 직접 복사 (git/이미지에 포함 안 됨)
COMPOSE_PROFILES=
# 카메라 주소 (쉼표 구분). 비밀번호에 특수문자가 있으면 URL 인코딩 (@ → %40, , → %2C)
# 값에 $ 가 있으면 작은따옴표로 감쌀 것: CAMERA_SOURCES='rtsp://...'
CAMERA_SOURCES=rtsp://user:pass@192.168.0.101:554/stream1,rtsp://user:pass@192.168.0.102:554/stream1
# 카메라 이름 (CAMERA_SOURCES 와 같은 순서). 대시보드의 담당 카메라 지정에 이 이름을 사용
CAMERA_NAMES=카메라1,카메라2
# cpu 또는 0(첫 번째 NVIDIA GPU)
DETECT_DEVICE=cpu
DETECT_CONF=0.25
# N 프레임마다 1번 추론 (카메라가 많거나 CPU 가 느리면 늘릴 것)
FRAME_SKIP=2
