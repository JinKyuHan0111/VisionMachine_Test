# docker/ 폴더 안에서 복사해서 사용:  cp .env.example .env  &&  chmod 600 .env
# (로컬 개발용 .env 는 프로젝트 루트, 배포용 .env 는 docker/ 에 둠)
# .env 는 절대 git 에 커밋하지 말 것 (.gitignore / .dockerignore 에 포함됨)

# ─── 서버 도메인 ─────────────────────────────────────
# Caddy 가 이 도메인으로 Let's Encrypt 인증서를 자동 발급 (DNS A 레코드가 서버 IP 를 가리켜야 함)
# 도메인이 없으면 연습용으로 <서버IP>.sslip.io 사용 가능 (예: 203.0.113.10.sslip.io)
DOMAIN=fire.example.com
APP_BASE_URL=https://fire.example.com

# ─── 세션 서명 키 (필수, 32자 이상) ──────────────────
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# ─── 초기 관리자 계정 (필수) ─────────────────────────
# 최초 기동 시 1회만 생성됨. 이후 이 값을 바꿔도 기존 비밀번호는 바뀌지 않음.
# 12자 이상, 기본값(changeme 등) 사용 시 서버가 기동을 거부함
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ─── 이메일 (Gmail 앱 비밀번호) ──────────────────────
# 계정 비밀번호가 아닌 2단계 인증 후 발급하는 '앱 비밀번호' 사용
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
