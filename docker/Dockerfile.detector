# syntax=docker/dockerfile:1
# 화재 감지기 이미지 (RTSP 카메라 → YOLO 추론 → SQLite/캡처 저장, 화면 없음)
# - 모델(.pt)과 비밀값은 이미지에 넣지 않음: 모델은 볼륨, 카메라 주소/메일은 환경변수로 주입
# - 기본은 CPU 용 torch. NVIDIA GPU 서버라면:
#     docker build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu128 ...

FROM python:3.12-slim

ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HEADLESS=1 \
    VECTOR_DB=off \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    YOLO_OFFLINE=1 \
    MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /app

# opencv-python(ultralytics 의존성)이 필요로 하는 런타임 라이브러리
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

# 웹 이미지와 같은 UID/GID → 공유 볼륨(data/)을 둘 다 쓸 수 있음
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app

RUN pip install --index-url "${TORCH_INDEX}" torch torchvision
COPY requirements-detector.txt .
RUN pip install -r requirements-detector.txt

# 감지에 필요한 코드만 (vector_db.py 제외 → ChromaDB 미사용)
COPY src/__init__.py src/__init__.py
COPY src/inference/ src/inference/
COPY src/alert/ src/alert/
COPY src/database/__init__.py src/database/sqlite_db.py src/database/db_manager.py src/database/

RUN mkdir -p data/db data/captures models && chown -R app:app data

USER app

CMD ["python", "-m", "src.inference.multi_monitor", "--headless"]
